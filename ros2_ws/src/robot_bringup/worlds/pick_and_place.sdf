<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="pick_and_place">
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 10 0 0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <attenuation>
            <range>1000</range>
            <constant>0.9</constant>
            <linear>0.01</linear>
            <quadratic>0.001</quadratic>
        </attenuation>
        <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
        <static>true</static>
        <link name="link">
            <collision name="collision">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                <size>100 100</size>
                </plane>
            </geometry>
            </collision>
            <visual name="visual">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                <size>100 100</size>
                </plane>
            </geometry>
            <material>
                <ambient>0.8 0.8 0.8 1</ambient>
                <diffuse>0.8 0.8 0.8 1</diffuse>
            </material>
            </visual>
        </link>
    </model>

    <model name="workspace_table">
        <static>true</static>
        <pose>0.6 0 0.15 0 0 0</pose>
        <link name="link">
            <collision name="collision">
            <geometry><box><size>0.6 0.8 0.3</size></box></geometry>
            </collision>
            <visual name="visual">
            <geometry><box><size>0.6 0.8 0.3</size></box></geometry>
            <material>
                <ambient>0.55 0.4 0.25 1</ambient>
                <diffuse>0.55 0.4 0.25 1</diffuse>
            </material>
            </visual>
        </link>
    </model>

    <model name="test_cube">
        <pose>0.508 -0.001 0.35 0 0 0</pose>
        <static>false</static>
        <link name="link">
            <inertial>
            <mass>0.2</mass>
            <inertia><ixx>0.000213</ixx><iyy>0.000213</iyy><izz>0.000213</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
            </inertial>
            <collision name="collision">
            <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
            </collision>
            <visual name="visual">
            <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
            <material>
                <ambient>1 0 0 1</ambient>
                <diffuse>1 0 0 1</diffuse>
            </material>
            </visual>
        </link>
    </model>

    <model name="scene_camera">
        <static>true</static>
        <pose>1.1 0 1.3 0 1.02 3.14159</pose>
        <link name="link">
            <visual name="visual">
            <geometry><box><size>0.08 0.16 0.08</size></box></geometry>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
            </material>
            </visual>
            <sensor name="scene_rgbd_camera" type="rgbd_camera">
            <always_on>true</always_on>
            <update_rate>15</update_rate>
            <topic>scene_camera</topic>
            <ignition_frame_id>scene_camera_link</ignition_frame_id>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                <width>640</width>
                <height>480</height>
                </image>
                <clip>
                <near>0.1</near>
                <far>3.0</far>
                </clip>
            </camera>
            </sensor>
        </link>
    </model>
  </world>
</sdf>
