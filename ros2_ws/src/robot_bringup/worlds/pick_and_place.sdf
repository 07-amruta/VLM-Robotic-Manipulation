    <model name="scene_camera">
        <static>true</static>
        <pose>0 1.25 1.3 0 1.02 4.7124</pose>
        <link name="link">
            <visual name="visual">
            <geometry><box><size>0.08 0.16 0.08</size></box></geometry>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
            </material>
            </visual>
            <sensor name="scene_rgbd_camera" type="rgbd_camera">
            <always_on>true</always_on>
            <update_rate>15</update_rate>
            <topic>scene_camera</topic>
            <ignition_frame_id>scene_camera_link</ignition_frame_id>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                <width>640</width>
                <height>480</height>
                </image>
                <clip>
                <near>0.1</near>
                <far>3.0</far>
                </clip>
            </camera>
            </sensor>
        </link>
    </model>
  </world>
</sdf>
