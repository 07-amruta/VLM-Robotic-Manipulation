<?xml version="1.0"?>
<robot name="ur10">

  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <group name="gripper">
    <joint name="gripper_finger_1_joint_1"/>
    <joint name="gripper_finger_2_joint_1"/>
    <joint name="gripper_finger_middle_joint_1"/>
  </group>

  <end_effector name="robotiq_3f" parent_link="tool0" group="gripper"/>

  <group_state name="open" group="gripper">
    <joint name="gripper_finger_1_joint_1" value="0.05"/>
    <joint name="gripper_finger_2_joint_1" value="0.05"/>
    <joint name="gripper_finger_middle_joint_1" value="0.05"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_finger_1_joint_1" value="1.0"/>
    <joint name="gripper_finger_2_joint_1" value="1.0"/>
    <joint name="gripper_finger_middle_joint_1" value="1.0"/>
  </group_state>

  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.57"/>
    <joint name="elbow_joint" value="0"/>
    <joint name="wrist_1_joint" value="-1.57"/>
    <joint name="wrist_2_joint" value="0"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <!-- Wrist / palm mount -->
  <disable_collisions link1="gripper_palm" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gripper_palm" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gripper_finger_1_link_0" reason="Never"/>
  <disable_collisions link1="tool0" link2="gripper_finger_2_link_0" reason="Never"/>
  <disable_collisions link1="tool0" link2="gripper_finger_middle_link_0" reason="Never"/>

  <!-- Finger 1 self-chain -->
  <disable_collisions link1="gripper_palm" link2="gripper_finger_1_link_0" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_1_link_0" link2="gripper_finger_1_link_1" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_1_link_1" link2="gripper_finger_1_link_2" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_1_link_2" link2="gripper_finger_1_link_3" reason="Adjacent"/>
  <disable_collisions link1="gripper_palm" link2="gripper_finger_1_link_1" reason="Never"/>
  <disable_collisions link1="gripper_palm" link2="gripper_finger_1_link_2" reason="Never"/>
  <disable_collisions link1="gripper_palm" link2="gripper_finger_1_link_3" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_0" link2="gripper_finger_1_link_2" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_0" link2="gripper_finger_1_link_3" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_1" link2="gripper_finger_1_link_3" reason="Never"/>

  <!-- Finger 2 self-chain -->
  <disable_collisions link1="gripper_palm" link2="gripper_finger_2_link_0" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_2_link_0" link2="gripper_finger_2_link_1" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_2_link_1" link2="gripper_finger_2_link_2" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_2_link_2" link2="gripper_finger_2_link_3" reason="Adjacent"/>
  <disable_collisions link1="gripper_palm" link2="gripper_finger_2_link_1" reason="Never"/>
  <disable_collisions link1="gripper_palm" link2="gripper_finger_2_link_2" reason="Never"/>
  <disable_collisions link1="gripper_palm" link2="gripper_finger_2_link_3" reason="Never"/>
  <disable_collisions link1="gripper_finger_2_link_0" link2="gripper_finger_2_link_2" reason="Never"/>
  <disable_collisions link1="gripper_finger_2_link_0" link2="gripper_finger_2_link_3" reason="Never"/>
  <disable_collisions link1="gripper_finger_2_link_1" link2="gripper_finger_2_link_3" reason="Never"/>

  <!-- Middle finger self-chain -->
  <disable_collisions link1="gripper_palm" link2="gripper_finger_middle_link_0" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_middle_link_0" link2="gripper_finger_middle_link_1" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_middle_link_1" link2="gripper_finger_middle_link_2" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_middle_link_2" link2="gripper_finger_middle_link_3" reason="Adjacent"/>
  <disable_collisions link1="gripper_palm" link2="gripper_finger_middle_link_1" reason="Never"/>
  <disable_collisions link1="gripper_palm" link2="gripper_finger_middle_link_2" reason="Never"/>
  <disable_collisions link1="gripper_palm" link2="gripper_finger_middle_link_3" reason="Never"/>
  <disable_collisions link1="gripper_finger_middle_link_0" link2="gripper_finger_middle_link_2" reason="Never"/>
  <disable_collisions link1="gripper_finger_middle_link_0" link2="gripper_finger_middle_link_3" reason="Never"/>
  <disable_collisions link1="gripper_finger_middle_link_1" link2="gripper_finger_middle_link_3" reason="Never"/>

  <!-- Cross-finger: fingers approach each other during a grasp -->
  <disable_collisions link1="gripper_finger_1_link_0" link2="gripper_finger_2_link_0" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_0" link2="gripper_finger_middle_link_0" reason="Never"/>
  <disable_collisions link1="gripper_finger_2_link_0" link2="gripper_finger_middle_link_0" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_1" link2="gripper_finger_2_link_1" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_1" link2="gripper_finger_middle_link_1" reason="Never"/>
  <disable_collisions link1="gripper_finger_2_link_1" link2="gripper_finger_middle_link_1" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_2" link2="gripper_finger_2_link_2" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_2" link2="gripper_finger_middle_link_2" reason="Never"/>
  <disable_collisions link1="gripper_finger_2_link_2" link2="gripper_finger_middle_link_2" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_3" link2="gripper_finger_2_link_3" reason="Never"/>
  <disable_collisions link1="gripper_finger_1_link_3" link2="gripper_finger_middle_link_3" reason="Never"/>
  <disable_collisions link1="gripper_finger_2_link_3" link2="gripper_finger_middle_link_3" reason="Never"/>

</robot>