<?xml version="1.0"?>
<!--
robotiq_3f_finger_articulated(prefix)

Ported from ros-industrial-attic/robotiq (ROS1, robotiq_3f_gripper_visualization)
to ROS 2 / ament_cmake. Original package: BSD licensed, Robotiq Inc.

Creates one articulated finger (3 revolute joints) with the given prefix.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="robotiq_3f_finger_articulated" params="prefix">

    <link name="${prefix}link_0">
      <visual>
        <origin xyz="0.020 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_3f_gripper_description/meshes/visual/link_0.dae"/>
        </geometry>
        <material name="gripper_dark">
          <color rgba="0.12 0.12 0.13 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.020 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_3f_gripper_description/meshes/collision/link_0.STL"/>
        </geometry>
      </collision>
      <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.05"/>
          <inertia ixx="4.9e-6" ixy="0" ixz="0" iyy="9.1e-6" iyz="0" izz="9.1e-6" />
      </inertial>
    </link>

    <link name="${prefix}link_1">
      <visual>
        <origin xyz="0.050 -0.028 0" rpy="0 0 -0.52"/>
        <geometry>
          <mesh filename="package://robotiq_3f_gripper_description/meshes/visual/link_1.dae"/>
        </geometry>
        <material name="gripper_light">
          <color rgba="0.65 0.66 0.68 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.050 -0.028 0" rpy="0 0 -0.52"/>
        <geometry>
          <mesh filename="package://robotiq_3f_gripper_description/meshes/collision/link_1.STL"/>
        </geometry>
      </collision>
      <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.15"/>
          <inertia ixx="1.08e-5" ixy="0" ixz="0" iyy="6.67e-5" iyz="0" izz="6.67e-5" />
      </inertial>
    </link>

    <link name="${prefix}link_2">
      <visual>
        <origin xyz="0.039 0 0.0075" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_3f_gripper_description/meshes/visual/link_2.dae"/>
        </geometry>
        <material name="gripper_light"/>
      </visual>
      <collision>
        <origin xyz="0.039 0 0.0075" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_3f_gripper_description/meshes/collision/link_2.STL"/>
        </geometry>
      </collision>
      <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.05"/>
          <inertia ixx="2.5e-6" ixy="0" ixz="0" iyy="7.9e-6" iyz="0" izz="7.9e-6" />
      </inertial>
    </link>

    <link name="${prefix}link_3">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0.52"/>
        <geometry>
          <mesh filename="package://robotiq_3f_gripper_description/meshes/visual/link_3.dae"/>
        </geometry>
        <material name="gripper_light"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0.52"/>
        <geometry>
          <mesh filename="package://robotiq_3f_gripper_description/meshes/collision/link_3.STL"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.001239" ixy="-0.000251" ixz="0.000019" iyy="0.00085" iyz="0" izz="0.001632"/>
      </inertial>
    </link>

    <joint name="${prefix}joint_1" type="revolute">
      <parent link="${prefix}link_0"/>
      <child link="${prefix}link_1"/>
      <!-- Keep the finger axis aligned with the official Robotiq Z-axis rotation.
           This is not mirrored or flipped relative to the palm frame, and the
           commanded position stays in the valid positive range. -->
      <axis xyz="0 0 1"/>
      <origin xyz="0.020 0 0" rpy="0 0 0"/>
      <limit lower="0.0495" upper="1.2218" effort="100" velocity="1.0"/>
    </joint>
    <joint name="${prefix}joint_2" type="fixed">
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <origin xyz="0.050 -0.028 0" rpy="0 0 -0.52"/>
    </joint>
    <joint name="${prefix}joint_3" type="fixed">
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <origin xyz="0.039 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
