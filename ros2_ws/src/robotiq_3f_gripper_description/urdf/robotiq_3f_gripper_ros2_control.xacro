<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro
    name="robotiq_3f_gripper_ros2_control"
    params="prefix sim_ignition:=true">

    <ros2_control name="${prefix}gripper_system" type="system">

      <hardware>

        <xacro:if value="${sim_ignition}">
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </xacro:if>

        <xacro:unless value="${sim_ignition}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>

      </hardware>

      <joint name="${prefix}finger_1_joint_1">
        <command_interface name="position">
          <param name="min">0.0495</param>
          <param name="max">1.2218</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0495</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}finger_2_joint_1">
        <command_interface name="position">
          <param name="min">0.0495</param>
          <param name="max">1.2218</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0495</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}finger_middle_joint_1">
        <command_interface name="position">
          <param name="min">0.0495</param>
          <param name="max">1.2218</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0495</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>