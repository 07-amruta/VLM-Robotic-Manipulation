<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotiq_3f_gripper_description</name>
  <version>0.1.0</version>
  <description>
    ROS 2 port of the Robotiq 3-Finger Adaptive Gripper (articulated) URDF/xacro
    and meshes, originally from ros-industrial-attic/robotiq (ROS1, BSD licensed).
    Provides a macro to attach the gripper to any parent link (e.g. a UR arm's
    tool0), plus a combined UR10 + gripper xacro.
  </description>
  <maintainer email="maintainer@example.com">Amruta</maintainer>
  <license>BSD</license>

  <url type="website">https://github.com/ros-industrial-attic/robotiq</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>urdf</exec_depend>

  <!-- needed only when building the combined ur10_robotiq_3f.urdf.xacro -->
  <exec_depend>ur_description</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
