{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔨 Build",
      "type": "shell",
      "command": "cd ${workspaceFolder}/ros2_ws && colcon build --packages-up-to robot_bringup --symlink-install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🚀 Launch",
      "type": "shell",
      "command": "cd ${workspaceFolder}/ros2_ws && source install/setup.bash && ros2 launch robot_bringup bringup.launch.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "⚡ Build & Launch",
      "dependsOrder": "sequence",
      "dependsOn": ["Build Workspace", "Launch Bringup"],
      "problemMatcher": []
    },
    {
      "label": "🧹 Clean Build",
      "type": "shell",
      "command": "cd ${workspaceFolder}/ros2_ws && rm -rf build install log && colcon build --symlink-install",
      "problemMatcher": []
    }
  ]
}